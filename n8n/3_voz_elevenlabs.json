   ],
   "parameters": {
    "jsCode": "const r = $input.first().json;\nconst limpio = String(r.mensaje || r.mensaje_solicitante || '').replace(/<[^>]+>/g, '');\nreturn [{ json: { creado: true, caso_id: r.caso_id, estado: r.estado, monto_total_mxn: r.monto_total, recomendacion: r.recomendacion, faltantes: r.faltantes, resumen: limpio.slice(0, 700), resultado: 'simulado' } }];"
   }
  },
  {
   "id": "0714b0ac-4f38-4dd6-86ee-cec013ff79cd",
   "name": "Respuesta inválida",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    480
   ],
   "parameters": {
    "jsCode": "const v=$input.first().json; return [{ json: { error: true, mensaje: v.error } }];"
   }
  },
  {
