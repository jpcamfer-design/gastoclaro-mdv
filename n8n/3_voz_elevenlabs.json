  {
   "id": "c22909a1-f73f-482c-861b-1a6223bd35f7",
   "name": "Respuesta consulta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    160
   ],
   "parameters": {
    "jsCode": "const id = $('Validar petición de voz').first().json.caso_id;\nconst NOMBRES = { 'POL-01': '(disponible presupuestal)', 'POL-02': '(faltan 2 cotizaciones)', 'POL-03': '(precio arriba de la referencia)', 'POL-04': '(categoría restringida)',\n  'POL-05': '(excede facultad de aprobación)', 'POL-06': '(urgencia crítica sin justificar)', 'POL-07': '(posible fraccionamiento: compras del mismo CC e ítem/proveedor en 7 días que juntas superan $50,000 sin 2 cotizaciones)' };\nconst c = $('Consultar caso').all().map(i => i.json).find(x => x.caso_id === id);\nconst tr = $input.all().map(i => i.json).filter(t => t.caso_id === id && !['presupuesto_ok', 'llm_ok'].includes(t.estado)).sort((a, b) => a.paso - b.paso)\n  .map(t => `${t.paso}. ${t.rol}${t.version ? ' v' + t.version : ''}: ${t.estado.replace(/_/g, ' ')}`);\nif (!c) return [{ json: { encontrado: false, caso_id: id, mensaje: `No existe el folio ${id} en el registro. No inventes un estado.` } }];\nreturn [{ json: { encontrado: true, caso_id: c.caso_id, estado: c.estado, centro_costo: c.centro_costo, concepto: c.concepto, monto_total_mxn: c.monto_total,\n  recomendacion: c.recomendacion, revision: c.veredicto, version: c.version, decision: (c.decision || 'sin decisión').replace(/ por .*\\(/, ' ('), actualizado: c.updatedAt,\n  politicas_con_falla: JSON.parse(c.politicas || '[]').filter(p => !p.ok).map(p => p.id + ' ' + (NOMBRES[p.id] || '')),\n  motivo_documentado: String(c.resumen || '').slice(0, 600), recorrido_auditoria: tr.slice(0, 18), resultado: 'simulado' } }];"
   }
  },
  {
   "id": "1e5ef4b4-6cce-4c58-9f9d-359cd2c0f3b5",
   "name": "Preparar caso de voz",
