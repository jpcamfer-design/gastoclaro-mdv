  {
   "id": "153165d0-36aa-4018-8ef3-8339b658ac1b",
   "name": "Respuesta consulta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    160
   ],
   "parameters": {
    "jsCode": "const id = $('Validar petición de voz').first().json.caso_id;\nconst c = $('Consultar caso').all().map(i => i.json).find(x => x.caso_id === id);\nconst tr = $input.all().map(i => i.json).filter(t => t.caso_id === id && !['presupuesto_ok', 'llm_ok'].includes(t.estado)).sort((a, b) => a.paso - b.paso)\n  .map(t => `${t.paso}. ${t.rol}${t.version ? ' v' + t.version : ''}: ${t.estado.replace(/_/g, ' ')}`);\nif (!c) return [{ json: { encontrado: false, caso_id: id, mensaje: `No existe el folio ${id} en el registro. No inventes un estado.` } }];\nreturn [{ json: { encontrado: true, caso_id: c.caso_id, estado: c.estado, centro_costo: c.centro_costo, concepto: c.concepto, monto_total_mxn: c.monto_total,\n  recomendacion: c.recomendacion, revision: c.veredicto, version: c.version, decision: (c.decision || 'sin decisión').replace(/ por .*\\(/, ' ('), actualizado: c.updatedAt,\n  politicas_con_falla: JSON.parse(c.politicas || '[]').filter(p => !p.ok).map(p => p.id), recorrido_auditoria: tr.slice(0, 18), resultado: 'simulado' } }];"
   }
  },
  {
   "id": "d081ca32-dcca-4f8a-bdb4-418bafd2d6da",
   "name": "Preparar caso de voz",
   "type": "n8n-nodes-base.code",
