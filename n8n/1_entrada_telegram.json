  {
   "id": "328b22fe-94bd-4fa1-b690-3d4ae507f9c2",
   "name": "Validar decisión (servidor)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2420,
    400
   ],
   "parameters": {
    "jsCode": "const e = $('Autorizar y enrutar').first().json;\nconst c = $input.all().map(i => i.json).find(x => x.caso_id === e.caso_id);\nlet ok = false, motivo = '';\nif (!e.puedeAprobar) motivo = 'No tienes rol de aprobador.';\nelse if (!c) motivo = 'Folio inexistente.';\nelse if (c.estado !== 'pendiente_aprobacion') motivo = `El caso ya está en estado ${c.estado}.`;\nelse if (Number(c.version) !== Number(e.version)) motivo = `La versión ${e.version} ya no es la vigente (v${c.version}).`;\nelse if (c.aprobacion_expira && new Date(c.aprobacion_expira) < new Date()) motivo = 'La solicitud de aprobación expiró.';\nelse ok = true;\nconst aprobado = e.accion === 'ap';\nconst ahora = new Date().toISOString();\nreturn [{ json: { ok, motivo, row_id: c ? c.id : null, caso_id: e.caso_id, aprobado, chat_aprobador: e.chat_id, chat_solicitante: c ? c.chat_solicitante : '',\n  callback_id: e.callback_id, message_id: e.message_id, version: e.version, ahora,\n  nuevo_estado: aprobado ? 'aprobado_simulado' : 'rechazado_aprobador', decision: (aprobado ? 'aprobado' : 'rechazado') + ' por ' + e.alias + ' (v' + e.version + ')' } }];"
   }
  },
