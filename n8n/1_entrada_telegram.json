   "id": "2a61fa0f-fdcd-45f8-9dc0-4644db881959",
   "name": "Normalizar evento",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    120
   ],
   "parameters": {
    "jsCode": "// Si llegó nota de voz, el texto transcrito entra al mismo flujo que un mensaje escrito\nconst ev = { ...$('Evento crudo').first().json };\nif (ev.voz_file_id) { const txt = String(($input.first().json || {}).text || '').trim(); if (txt) { ev.texto = txt; ev.tiene_texto = true; ev.por_voz = true; } }\nreturn [{ json: ev }];"
   }
  },
