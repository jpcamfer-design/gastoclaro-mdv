  {
   "id": "1013c40f-d151-438a-8ebc-5cd4e6194da7",
   "name": "Formatear estado",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2420,
    200
   ],
   "parameters": {
    "jsCode": "const e = $('Autorizar y enrutar').first().json;\nconst c = $input.all().map(i => i.json).find(x => x.caso_id === e.caso_id);\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst fmt = n => Number(n || 0).toLocaleString('es-MX');\nlet t;\nif (!c || (c.chat_solicitante !== e.chat_id && !e.puedeAprobar)) t = `No encontré el folio ${esc(e.caso_id)} entre tus casos.`;\nelse t = `<b>${esc(c.caso_id)}</b> · estado: <b>${esc(c.estado)}</b>\\n${esc(c.concepto)}\\nCC ${esc(c.centro_costo)} · $${fmt(c.monto_total)} MXN\\nRecomendación: ${esc(c.recomendacion || 'n/d')} · Revisión: ${esc(c.veredicto || 'n/d')} (v${c.version})` +\n  (c.decision ? `\\nDecisión: ${esc(c.decision)}` : '') + (c.aprobacion_expira && c.estado === 'pendiente_aprobacion' ? `\\nExpira: ${new Date(c.aprobacion_expira).toLocaleString('es-MX', { timeZone: 'America/Mexico_City' })}` : '') + '\\n<i>Resultado simulado</i>';\nreturn [{ json: { chat_id: e.chat_id, texto: t } }];"
   }
  },
