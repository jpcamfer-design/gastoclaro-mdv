  {
   "id": "ca909108-2222-4a37-816e-5ab5bdc0a80a",
   "name": "Autorizar y enrutar",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1760,
    300
   ],
   "parameters": {
    "jsCode": "const ev = $('Normalizar evento').first().json;\nconst u = $input.all().map(i => i.json).find(x => x.chat_id === ev.chat_id && x.activo) || null;\nlet ruta = 'invalido', caso_id = '', accion = '', version = 0;\nconst t = ev.texto;\nif (!u) ruta = 'no_autorizado';\nelse if (ev.tipo === 'decision') { const p = ev.callback_data.split('|'); if (p[0] === 'd' && ['ap', 'rc'].includes(p[1]) && /^GAS-\\d{4}$/.test(p[2] || '')) { ruta = 'decision'; accion = p[1]; caso_id = p[2]; version = Number(p[3] || 0); } }\nelse if (!ev.tiene_texto) ruta = 'sin_texto';\nelse if (/^\\/(start|ayuda|help)/i.test(t)) ruta = 'ayuda';\nelse if (/^\\/estado/i.test(t)) { const m = t.toUpperCase().match(/GAS-?\\s?(\\d{1,4})/); ruta = m ? 'estado' : 'estado_sin_folio'; caso_id = m ? 'GAS-' + m[1].padStart(4, '0') : ''; }\nelse if (/^\\/nuevo/i.test(t)) ruta = 'nuevo';\nelse ruta = 'invalido';\nconst puedeSolicitar = u && ['solicitante', 'ambos'].includes(u.rol), puedeAprobar = u && ['aprobador', 'ambos'].includes(u.rol);\nif (ruta === 'nuevo' && !puedeSolicitar) ruta = 'no_autorizado';\nreturn [{ json: { ...ev, ruta, caso_id, accion, version, alias: u ? u.alias : '', rol: u ? u.rol : '', puedeAprobar: !!puedeAprobar } }];"
   }
  },
