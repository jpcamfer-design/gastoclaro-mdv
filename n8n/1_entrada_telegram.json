  {
   "id": "7a17bd74-b0b0-4ae6-ae03-19e0367664af",
   "name": "Normalizar evento",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    300
   ],
   "parameters": {
    "jsCode": "const u = $input.first().json;\nconst cb = u.callback_query;\nconst msg = cb ? cb.message : u.message;\nconst ev = { event_key: 'tg-' + (u.update_id ?? (msg && msg.message_id)), chat_id: String(cb ? cb.from.id : (msg && msg.chat && msg.chat.id) || ''),\n  texto: cb ? '' : String((msg && (msg.text || msg.caption)) || '').trim(), tiene_texto: !!(msg && msg.text), tipo: cb ? 'decision' : 'mensaje',\n  callback_id: cb ? cb.id : '', callback_data: cb ? String(cb.data || '') : '', message_id: msg ? msg.message_id : null, recibido: new Date().toISOString() };\nreturn [{ json: ev }];"
   }
  },
