  {
   "id": "eab26e10-16ad-41cc-96cb-3021fcbf5d51",
   "name": "Detectar vencidos",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    200
   ],
   "parameters": {
    "jsCode": "const ahora = new Date();\nreturn $input.all().map(i => i.json).filter(c => c.caso_id && c.aprobacion_expira && new Date(c.aprobacion_expira) < ahora)\n  .map(c => ({ json: { row_id: c.id, caso_id: c.caso_id, chat_solicitante: c.chat_solicitante } }));"
   }
  },
  {
   "id": "28785d6a-ada4-43fd-92c7-ed2d9bc2de3f",
   "name": "Fila vencido",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    200
   ],
   "parameters": {
    "jsCode": "return $input.all().map(i => ({ json: { estado: 'expirado', decision: 'expiró sin aprobación (24 h)', decidido_en: new Date().toISOString() } }));"
   }
  },
