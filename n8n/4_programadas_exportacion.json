  {
   "id": "4e88fbdb-50dd-40f2-a83e-ca0a932c013c",
   "name": "Exportación sanitizada",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    500
   ],
   "parameters": {
    "jsCode": "// Solo datos ficticios agregados o sin identificadores: sin chat_id, alias, ejecuciones ni textos libres largos.\nconst mask = s => String(s || '').replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[correo]').replace(/\\d{7,}/g, '[num]').slice(0, 90);\nconst casos = $('Todos los casos').all().map(i => i.json).filter(c => c.caso_id).map(c => ({\n  caso_id: c.caso_id, canal: c.canal, estado: c.estado, version: c.version, centro_costo: c.centro_costo, concepto: mask(c.concepto), item_id: c.item_id,\n  cantidad: c.cantidad, precio_unitario: c.precio_unitario, precio_ref: c.precio_ref, variacion_precio: c.variacion_precio, monto_total: c.monto_total,\n  disponible_despues: c.disponible_despues, urgencia: c.urgencia, recomendacion: c.recomendacion, veredicto: c.veredicto, iteraciones: c.iteraciones,\n  decision: c.decision ? c.decision.replace(/ por .*\\(/, ' (') : '', creado: c.createdAt, decidido_en: c.decidido_en || null,\n  llamadas_llm: c.llamadas_llm, tokens_in_est: c.tokens_in_est, tokens_out_est: c.tokens_out_est, costo_est_usd: c.costo_est_usd }));\nconst trazas = $('Todas las trazas').all().map(i => i.json).filter(t => t.caso_id).map(t => ({ caso_id: t.caso_id, paso: t.paso, rol: t.rol, version: t.version, estado: t.estado, skill: t.skill,\n  tokens_in_est: t.tokens_in_est, tokens_out_est: t.tokens_out_est, costo_est_usd: t.costo_est_usd, ts: t.createdAt }));\nconst presupuesto = $('Presupuesto vigente').all().map(i => i.json).filter(p => p.centro_costo).map(p => ({ centro_costo: p.centro_costo, nombre: p.nombre, presupuesto_mensual: p.presupuesto_mensual, comprometido: p.comprometido, periodo: p.periodo }));\nreturn [{ json: { generado: new Date().toISOString(), fuente: 'n8n Data Tables mdv_casos/mdv_trazas (exportación sanitizada)', modo: 'SIMULADO', ficticio: true, casos, trazas, presupuesto } }];"
   },
   "executeOnce": true
  },
