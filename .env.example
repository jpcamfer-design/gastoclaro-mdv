# Nombres de variables y credenciales (SIN valores). Los valores viven en n8n Credentials y GitHub Secrets.
# n8n Credentials
TELEGRAM_BOT_TOKEN=          # credencial "Telegram GastoClaro" (Telegram API)
GASTOCLARO_VOZ_KEY=          # credencial "GastoClaro voz (header)", encabezado X-GastoClaro-Key
GASTOCLARO_EXPORT_KEY=       # credencial "GastoClaro export (header)", encabezado X-GastoClaro-Key
# Modelo: Gateway credits de n8n (gpt-4o-mini), sin API key propia
# GitHub Actions secrets
N8N_EXPORT_URL=              # https://<instancia>.app.n8n.cloud/webhook/gastoclaro-export
N8N_EXPORT_KEY=              # mismo valor que GASTOCLARO_EXPORT_KEY
# ElevenLabs (secreto del workspace usado por la herramienta webhook)
ELEVENLABS_TOOL_SECRET=      # mismo valor que GASTOCLARO_VOZ_KEY
ELEVENLABS_API_KEY=          # credencial "ElevenLabs API" (encabezado xi-api-key) para el briefing de voz
ELEVENLABS_VOICE_ID=         # reemplaza __VOICE_ID__ en n8n/4; usar una voz "premade" (plan gratis), p. ej. Sarah
